{
  "name": "db-studio",
  "version": "1.2.0",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dist": "npm run build && electron-builder --win --portable"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.2",
    "lucide-react": "^0.394.0",
    "framer-motion": "^11.2.10"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.3.1",
    "typescript": "^5.2.2"
  },
  "build": {
    "appId": "com.dbstudio.pro",
    "productName": "dB Studio",
    "win": {
      "target": "portable"
    },
    "directories": {
      "output": "release"
    }
  }
}
