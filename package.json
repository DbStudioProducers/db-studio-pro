{
  "name": "db-studio",
  "version": "1.2.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "dist": "npm run build && electron-builder --win --portable"
  },
  "build": {
    "appId": "com.dbstudio.pro",
    "productName": "dB Studio",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "portable"
    },
    "directories": {
      "output": "release"
    }
  }
}
