{
  "name": "db-studio",
  "version": "1.2.0",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dist": "npm run build && electron-builder --win --portable"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.394.0",
    "framer-motion": "^11.2.10",
    "zustand": "^4.5.2",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.2.2",
    "vite": "^5.3.1",
    "vite-plugin-singlefile": "^2.0.1",
    "tailwindcss": "^3.4.4",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38"
  },
  "build": {
    "appId": "com.dbstudio.pro",
    "productName": "dB Studio",
    "win": {
      "target": "portable",
      "icon": "public/icon.ico"
    },
    "directories": {
      "output": "release"
    }
  }
